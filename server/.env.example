# Where the SQLite file lives. On Railway, mount a volume at /data so lanterns survive a redeploy.
DATABASE_PATH=/data/portfolio.db
# Sites allowed to call the API from a browser, comma-separated.
ALLOWED_ORIGINS=https://kekaisik1.github.io
# Notes are forwarded to this Telegram chat. Leave both empty and notes are only stored (and counted in the log).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# A long random string. The Claude hook sends it to set the "last seen working on" line. Empty = that endpoint is off.
NOW_TOKEN=
# Whose sky the drawing copies.
WEATHER_PLACE=Astana
WEATHER_LAT=51.1694
WEATHER_LON=71.4491
