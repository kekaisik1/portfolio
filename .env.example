# Address of the small API behind lanterns, notes, weather, growth and the "last seen working on" line.
# Empty (or unset) = the page runs on its own: nothing is sent anywhere, lanterns stay in the browser,
# and "leave a note" says it didn't go through and gives the email.
# Production (set in .github/workflows/pages.yml): https://api-production-2660.up.railway.app
VITE_API_URL=

# Only used when the page is opened on localhost or 127.0.0.1 AND VITE_API_URL is set:
# the page then talks to a local copy of the API on this port instead of the real one.
VITE_LOCAL_API_PORT=8787
